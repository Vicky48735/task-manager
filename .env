# Environment
NODE_ENV=development

# Application URL
APP_URL="http://localhost:3000"

# Server Port
PORT=3000

# MongoDB Database URL
# IMPORTANT: You MUST replace this placeholder with your actual MongoDB Atlas connection string!
# It should look like: mongodb+srv://<username>:<password>@cluster0...
DATABASE_URL="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/taskmanager?retryWrites=true&w=majority"
# JWT Config
JWT_SECRET="super_secret_key_change_me_in_production"
JWT_EXPIRES_IN="7d"
