# Environment
NODE_ENV=development

# Application URL
APP_URL="http://localhost:3000"

# Server Port (MUST BE 3000 when running in certain environments)
PORT=3000

# PostgreSQL Database URL
# In real application, swap with your live Postgres URL.
# Note: For Railway deployment use the provided DATABASE_URL
DATABASE_URL="postgresql://user:password@localhost:5432/taskmanager?schema=public"

# JWT Config
JWT_SECRET="super_secret_key_change_me_in_production"
JWT_EXPIRES_IN="7d"

# Required for AI config usually but not essential for just auth unless instructed
GEMINI_API_KEY=""
